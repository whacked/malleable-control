#!/usr/bin/env bash
# Install the bus participant into GT's startup, so that launching
# GlamorousToolkit.app normally brings up a connected participant.
#
# This writes ONE file into your Pharo preferences:
#   ~/Library/Preferences/pharo/12.0/mc-bus-startup.st
#
# Why there and not next to the image: GT's image-folder startup hook resolves
# against FileSystem workingDirectory, not the image directory. Launching from
# Finder gives a working directory of "/", so an image-local startup.st would
# silently never run. The preferences folder is an absolute path and works
# regardless of how GT was launched.
#
# That folder is shared by every Pharo 12 image on this machine, so the
# generated script guards on the image path and no-ops in any other image.
#
# Opt-in and reversible: bin/gt-uninstall-startup removes it. No demo or test
# script calls this.
source "$(dirname "$0")/_common.sh"

PREFS_DIR="$HOME/Library/Preferences/pharo/12.0"
SCRIPT="$PREFS_DIR/mc-bus-startup.st"

[ -f "$GT_IMAGE" ] || die "GT image not found at $GT_IMAGE (set GT_HOME)"

mkdir -p "$PREFS_DIR"
mkdir -p "$MC_RUN_DIR"
cat > "$SCRIPT" <<STARTUP
"malleable-control bus participant.
 Generated by bin/gt-install-startup -- edit the repo, not this file.
 Remove with bin/gt-uninstall-startup.

 Everything here is logged to run/gt-startup.log. On a GUI launch the
 Transcript is invisible, so a script that reported only there would fail
 completely silently -- which is indistinguishable from not running at all."

[ | log mine note |
  log := '$MC_RUN_DIR/gt-startup.log' asFileReference.
  note := [ :text |
    log ensureCreateFile.
    log writeStreamDo: [ :s |
      s setToEnd; nextPutAll: DateAndTime now printString , ' ' , text; lf ] ].

  "Match on the resolved image FILE, not on a path string. The launcher may
   hand the image a differently-spelled but equivalent path, and a string
   compare would then silently skip -- no error, no connection, no clue."
  mine := [ Smalltalk imagePath asFileReference asAbsolute canonicalize
              = '$GT_IMAGE' asFileReference asAbsolute canonicalize ]
            on: Error do: [ :e | Smalltalk imagePath = '$GT_IMAGE' ].

  note value: 'startup script ran; imagePath=' , Smalltalk imagePath printString
      , ' matches=' , mine printString.

  mine
    ifTrue: [
      Smalltalk at: #McHome put: '$MC_HOME'.
      Smalltalk at: #McNatsHost put: '$MC_NATS_HOST'.
      Smalltalk at: #McNatsPort put: $MC_NATS_PORT.
      Smalltalk at: #McStartupLog put: log fullName.
      ('$MC_HOME/pharo/mc-bootstrap.st') asFileReference fileIn ]
    ifFalse: [ note value: 'not this image, skipping' ] ]
  on: Error
  do: [ :e |
    [ '$MC_RUN_DIR/gt-startup.log' asFileReference writeStreamDo: [ :s |
        s setToEnd; nextPutAll: 'startup script FAILED: ' , e messageText printString; lf ] ]
      on: Error do: [ :ignored | ].
    Transcript show: '[mc-gt] startup script failed: ' , e messageText printString; cr ]!
STARTUP

info "installed: $SCRIPT"
info "  image  : $GT_IMAGE"
info "  repo   : $MC_HOME"
info "  bus    : $MC_NATS_URL"
info ""
info "Launch GlamorousToolkit.app normally and it will connect."
info "Remove with: bin/gt-uninstall-startup"
